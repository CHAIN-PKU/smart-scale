# Which ScaleDevice implementation the host constructs.
# simulator: no hardware. serial: real STM32 over UART.
SCALE_DEVICE=simulator

# disabled: do not recognize.
# mock: fixed banana, no network.
# minimax: MiniMax multimodal model.
# volcano: Volcano Engine Ark multimodal model.
VISION_PROVIDER=disabled

# disabled: do not look up a price.
# mock: fixed price for tests, no network.
# text: a smaller text model looks up price and facts after recognition.
PRODUCT_INFO_PROVIDER=disabled

# SQLite stores weighing sessions and corrections, not the full price catalog.
DATABASE_PATH=data/scale.db

# Used only when SCALE_DEVICE=serial. Example: COM3
SERIAL_PORT=

# Leave these blank. Put real keys in .env, which is not committed.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_VISION_MODEL=

VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_VISION_MODEL=

TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=
TEXT_MODEL_NAME=
