# Which ScaleDevice implementation the host constructs.
# simulator: no hardware. serial: real STM32 over UART.
SCALE_DEVICE=simulator

# disabled: print the switches and stop.
# mock: no-camera demo. Startup prices a simulated banana.
# minimax: MiniMax multimodal model. Needs MINIMAX_API_KEY.
# volcano: Volcano Engine Ark multimodal model. Needs VOLCENGINE_API_KEY.
# siliconflow: SiliconFlow vision model. Needs SILICONFLOW_API_KEY.
# Leave this on mock until a real photo should be sent.
VISION_PROVIDER=mock

# disabled: do not look up a price.
# mock: fixed price for the no-camera demo.
# table: local demo foods by name. Banana is 12 yuan/kg, 91 kcal and 22 g carb per 100 g.
# text: a smaller text model looks up price and facts after recognition.
PRODUCT_INFO_PROVIDER=mock

# SQLite stores weighing sessions and corrections, not the full price catalog.
DATABASE_PATH=data/scale.db

# Used only when SCALE_DEVICE=serial. Example: COM3
SERIAL_PORT=

# Leave these blank. Put real keys in .env, which is not committed.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_VISION_MODEL=

VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_VISION_MODEL=

TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=
TEXT_MODEL_NAME=

# SiliconFlow. The key stays in .env and is not committed.
# Vision model name comes from the console, filtered by 视觉.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_VISION_MODEL=
